{
  "name": "payent_monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "start": "npm --prefix frontend run start",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "format": "npm --prefix frontend run format",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --host 127.0.0.1 --port 8001",
    "dev:all": "start npm run dev:backend && npm run dev",
    "test:backend": "cd backend && pytest"
  }
}
