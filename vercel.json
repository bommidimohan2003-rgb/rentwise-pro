{
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
