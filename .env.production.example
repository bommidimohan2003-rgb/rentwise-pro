# ==========================================================
# PAYENT PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================
# IMPORTANT: Never commit actual secret keys to source control.
# Set these values in your hosting provider's Environment Variables dashboard.

# --- 1. ENVIRONMENT MODE ---
ENV=production
ENVIRONMENT=production

# --- 2. FASTAPI BACKEND SECRETS ---
# Generate 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_PRODUCTION_JWT_KEY

# Strict Admin Setup Code required for self-registering admins at /register
ADMIN_SETUP_CODE=REPLACE_WITH_STRONG_ADMIN_SETUP_CODE

# --- 3. DATABASE CONFIGURATION (MySQL) ---
# Automatically provided by Railway/Render MySQL, or set manually:
DATABASE_URL=mysql://root:PASS@MYSQL_HOST:3306/payent_db
MYSQL_HOST=mysql.railway.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
MYSQL_DB=payent_db

# --- 4. CORS ORIGINS ---
# Comma-separated list of allowed frontend domains
ALLOWED_ORIGINS=https://payent.vercel.app,https://payent.in,https://www.payent.in

# --- 5. RAZORPAY LIVE MODE PAYMENT GATEWAY ---
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# --- 6. FRONTEND VITE ENVIRONMENT (Set in Vercel Dashboard) ---
# Build-time variable pointing frontend requests to deployed backend
VITE_API_BASE_URL=https://api.payent.in
